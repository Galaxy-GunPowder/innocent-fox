+// Innocent Fox: the claimed GPU's value for aPname from ifox.webgl.parameters
+// ("pname:value;pname:value,value;..."). False = use the real value.
+static bool IfoxWebGLParameter(const GLenum aPname,
+                               AutoTArray<double, 2>& aValues) {
+  nsAutoCString list;
+  {
+    auto lock = StaticPrefs::ifox_webgl_parameters();
+    list = *lock;
+  }
+  for (const auto& entry : list.Split(';')) {
+    const int32_t colon = entry.FindChar(':');
+    if (colon <= 0) {
+      continue;
+    }
+    nsAutoCString key(Substring(entry, 0, colon));
+    key.Trim(" ");
+    nsresult rv = NS_ERROR_FAILURE;
+    const uint32_t pname =
+        StringBeginsWith(key, "0x"_ns) || StringBeginsWith(key, "0X"_ns)
+            ? nsAutoCString(Substring(key, 2)).ToInteger(&rv, 16)
+            : key.ToInteger(&rv);
+    if (NS_FAILED(rv) || pname != aPname) {
+      continue;
+    }
+    aValues.Clear();
+    for (const auto& part : Substring(entry, colon + 1).Split(',')) {
+      nsAutoCString number(part);
+      number.Trim(" ");
+      const double value = number.ToDouble(&rv);
+      if (NS_FAILED(rv)) {
+        return false;
+      }
+      aValues.AppendElement(value);
+    }
+    return aValues.Length() == 1 || aValues.Length() == 2;
+  }
+  return false;
+}
+
+// Innocent Fox: true if ifox.webgl.hiddenExtensions lists aName.
+static bool IfoxWebGLExtensionHidden(const char* const aName) {
+  nsAutoCString list;
+  {
+    auto lock = StaticPrefs::ifox_webgl_hiddenExtensions();
+    list = *lock;
+  }
+  for (const auto& part : list.Split(',')) {
+    nsAutoCString name(part);
+    name.Trim(" ");
+    if (!name.IsEmpty() &&
+        name.Equals(aName, nsCaseInsensitiveCStringComparator)) {
+      return true;
+    }
+  }
+  return false;
+}
