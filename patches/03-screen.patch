@@ -22,6 +24,29 @@
 using namespace mozilla;
 using namespace mozilla::dom;
 
+// Innocent Fox: the profile's screen, given in device pixels, as an app-unit
+// rect, or the real one. Web content only; browser UI keeps the real screen.
+// Device pixels times the context's own app units per pixel is exactly what
+// the real monitor rect goes through, so DPI scaling, zoom and rounding come
+// out the same as on a real screen of that size.
+// layout/style/nsMediaFeatures.cpp has the same rule for device-width.
+static bool IfoxScreenActive(nsPIDOMWindowInner* aOwner) {
+  Document* doc = aOwner ? aOwner->GetExtantDoc() : nullptr;
+  return StaticPrefs::ifox_screen_width() > 0 &&
+         StaticPrefs::ifox_screen_height() > 0 && doc &&
+         !doc->NodePrincipal()->IsSystemPrincipal();
+}
+
+static nsRect IfoxScreenRect(nsDeviceContext* aContext,
+                             nsPIDOMWindowInner* aOwner) {
+  if (!IfoxScreenActive(aOwner)) {
+    return aContext->GetRect();
+  }
+  const int32_t appUnitsPerDevPixel = aContext->AppUnitsPerDevPixel();
+  return nsRect(0, 0, StaticPrefs::ifox_screen_width() * appUnitsPerDevPixel,
+                StaticPrefs::ifox_screen_height() * appUnitsPerDevPixel);
+}
+
 nsScreen::nsScreen(nsPIDOMWindowInner* aWindow)
     : DOMEventTargetHelper(aWindow) {}
 
@@ -96,7 +121,8 @@
   if (NS_WARN_IF(!context)) {
     return {};
   }
-  return CSSIntRect::FromAppUnitsRounded(context->GetRect());
+  return CSSIntRect::FromAppUnitsRounded(
+      IfoxScreenRect(context, GetOwnerWindow()));
 }
 
 CSSIntRect nsScreen::GetAvailRect() {
@@ -142,12 +168,20 @@
     }
 
     return nsRFPService::GetSpoofedScreenAvailSize(
-        context->GetRect(), context->GetFullZoom(), IsFullscreen());
+        IfoxScreenRect(context, GetOwnerWindow()), context->GetFullZoom(),
+        IsFullscreen());
   }
 
   nsDeviceContext* context = GetDeviceContext();
   if (NS_WARN_IF(!context)) {
     return {};
+  }
+  // Innocent Fox: with a fake screen and the baseline rule turned off, use
+  // the same Windows taskbar shape the baseline rule uses.
+  if (IfoxScreenActive(GetOwnerWindow())) {
+    return nsRFPService::GetSpoofedScreenAvailSize(
+        IfoxScreenRect(context, GetOwnerWindow()), context->GetFullZoom(),
+        IsFullscreen());
   }
   return CSSIntRect::FromAppUnitsRounded(context->GetClientRect());
 }
