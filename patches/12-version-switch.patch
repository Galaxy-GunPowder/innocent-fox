+// Innocent Fox: ifox.compat.edits, the version switch for interface members.
+// "Iface.member=hide" removes a member from the prototype (or from a
+// namespace object), as in a version that never had it; "Iface.static.member"
+// does the same on the interface object, for static members and constants.
+// "Iface.method=length:N" sets a method's length, for a method whose argument
+// list changed between versions. aStatic: aObj is the interface object.
+static void IfoxApplyCompatEdits(JSContext* aCx, JS::Handle<JSObject*> aObj,
+                                 const char* aName, bool aStatic) {
+  const nsDependentCString iface(aName);
+  // Firefox 158 made these read-only; the IDL keeps 157's setters.
+  if (!aStatic && iface.EqualsLiteral("RTCSessionDescription") &&
+      !StaticPrefs::ifox_compat_webrtc_writableSessionDescription()) {
+    IfoxDropSetter(aCx, aObj, "type");
+    IfoxDropSetter(aCx, aObj, "sdp");
+  }
+  nsAutoCString edits;
+  {
+    auto lock = StaticPrefs::ifox_compat_edits();
+    edits = *lock;
+  }
+  if (edits.IsEmpty()) {
+    return;
+  }
+  for (const auto& part : edits.Split(';')) {
+    nsAutoCString item(part);
+    item.Trim(" ");
+    const int32_t dot = item.FindChar('.');
+    const int32_t eq = item.FindChar('=');
+    if (dot <= 0 || eq <= dot + 1 || !Substring(item, 0, dot).Equals(iface)) {
+      continue;
+    }
+    nsAutoCString member(Substring(item, dot + 1, eq - dot - 1));
+    if (StringBeginsWith(member, "static."_ns) != aStatic) {
+      continue;
+    }
+    if (aStatic) {
+      member.Cut(0, 7);
+    }
+    const nsAutoCString action(Substring(item, eq + 1));
+    if (action.EqualsLiteral("hide")) {
+      JS::ObjectOpResult ignored;
+      if (!JS_DeleteProperty(aCx, aObj, member.get(), ignored)) {
+        JS_ClearPendingException(aCx);
+      }
+    } else if (StringBeginsWith(action, "length:"_ns)) {
+      nsresult rv;
+      const nsAutoCString number(Substring(action, 7));
+      const int32_t length = number.ToInteger(&rv);
+      JS::Rooted<JS::Value> fn(aCx);
+      if (NS_FAILED(rv) || length < 0 ||
+          !JS_GetProperty(aCx, aObj, member.get(), &fn) || !fn.isObject() ||
+          !JS::IsCallable(&fn.toObject())) {
+        JS_ClearPendingException(aCx);
+        continue;
+      }
+      // Same attributes as a built-in length: not writable, not enumerable,
+      // configurable.
+      JS::Rooted<JSObject*> fnObj(aCx, &fn.toObject());
+      if (!JS_DefineProperty(aCx, fnObj, "length", length, JSPROP_READONLY)) {
+        JS_ClearPendingException(aCx);
+      }
+    }
+  }
 }
 
