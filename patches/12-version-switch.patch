+// Innocent Fox: an accessor made read-only, with the same getter and no
+// setter. Redefining keeps the property where it was in the object.
+static void IfoxDropSetter(JSContext* aCx, JS::Handle<JSObject*> aObj,
+                           const char* aName) {
+  JS::Rooted<mozilla::Maybe<JS::PropertyDescriptor>> desc(aCx);
+  if (!JS_GetOwnPropertyDescriptor(aCx, aObj, aName, &desc)) {
+    JS_ClearPendingException(aCx);
+    return;
+  }
+  if (desc.isNothing() || !desc->isAccessorDescriptor() || !desc->getter() ||
+      !desc->setter()) {
+    return;
+  }
+  // A complete descriptor with set: undefined. JS_DefineProperty with a null
+  // setter would mean "leave the setter as it is".
+  const unsigned attrs = (desc->enumerable() ? JSPROP_ENUMERATE : 0) |
+                         (desc->configurable() ? 0 : JSPROP_PERMANENT);
+  JS::Rooted<JS::PropertyDescriptor> readOnly(
+      aCx, JS::PropertyDescriptor::Accessor(desc->getter(), nullptr, attrs));
+  JSString* str = JS_AtomizeString(aCx, aName);
+  if (!str) {
+    JS_ClearPendingException(aCx);
+    return;
+  }
+  JS::Rooted<jsid> id(aCx, JS::PropertyKey::NonIntAtom(str));
+  if (!JS_DefinePropertyById(aCx, aObj, id, readOnly)) {
+    JS_ClearPendingException(aCx);
+  }
+}
