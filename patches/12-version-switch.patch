+# Version switch: what a page sees of an older Firefox, on this build. Defaults
+# are stock 160. tests/identity/versions.py works out the values per version.
+#
+# Member edits applied to each interface prototype as a page's global is made
+# (windows and workers): "Iface.member=hide;Iface.method=length:1". Chrome code
+# is never affected.
+- name: ifox.compat.edits
+  type: DataMutexString
+  value: ""
+  mirror: always
+
+# Firefox 159 and older: WebTransport datagram incomingHighWaterMark and
+# outgoingHighWaterMark, with 159's own getters and setters. Hide the 160
+# replacements with ifox.compat.edits.
+- name: ifox.compat.webtransport.highWaterMark
+  type: RelaxedAtomicBool
+  value: false
+  mirror: always
+
+# Firefox 160 probes video decoders with AssertCanInstantiate. false = 159's
+# probe, without it.
+- name: ifox.compat.media.assertCanInstantiate
+  type: RelaxedAtomicBool
+  value: true
+  mirror: always
+
+# Firefox 160 makes up a default decoder config for VP8, VP9, AV1 and HEVC codec
+# strings that carry none, so mediaCapabilities finds the hardware decoder
+# (powerEfficient true). false = 159 and older, without it.
+- name: ifox.compat.media.synthesizeCodecConfig
+  type: RelaxedAtomicBool
+  value: true
+  mirror: always
+
+# Firefox 158 and newer offer AV1 to WebRTC with profile, level-idx and tier
+# (an sdpFmtpLine in getCapabilities and the offer). false = 157 and older.
+- name: ifox.compat.webrtc.av1Fmtp
+  type: RelaxedAtomicBool
+  value: true
+  mirror: always
+
+# RTCSessionDescription.type and .sdp are read-only from Firefox 158. true =
+# 157 and older: writable, with a deprecation warning on first write.
+- name: ifox.compat.webrtc.writableSessionDescription
+  type: RelaxedAtomicBool
+  value: false
+  mirror: always
+
+# Firefox 155 and older offered the FFDHE 2048 and 3072 groups in every TLS
+# ClientHello; 156 offers them only with DHE ciphers on. true = 155's list.
+- name: ifox.compat.tls.ffdheGroups
+  type: RelaxedAtomicBool
+  value: false
+  mirror: always
+
 # IANA time zone for pages and every kind of worker, e.g. America/New_York.
 # "" = the real one. Windows ignores the TZ variable for such names.
