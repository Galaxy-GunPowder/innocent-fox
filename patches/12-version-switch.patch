+// "Iface.CONST=hide" or "Iface.static.CONST=hide": a constant a version never
+// had is missing from the prototype and the interface object alike.
+static bool IfoxHidesConstant(const char* aName) {
+  if (!sIfoxDefining) {
+    return false;
+  }
+  nsAutoCString edits;
+  {
+    auto lock = StaticPrefs::ifox_compat_edits();
+    edits = *lock;
+  }
+  if (edits.IsEmpty()) {
+    return false;
+  }
+  nsAutoCString onProto(sIfoxDefining);
+  onProto.AppendLiteral(".");
+  onProto.Append(aName);
+  onProto.AppendLiteral("=hide");
+  nsAutoCString onInterface(sIfoxDefining);
+  onInterface.AppendLiteral(".static.");
+  onInterface.Append(aName);
+  onInterface.AppendLiteral("=hide");
+  for (const auto& part : edits.Split(';')) {
+    nsAutoCString item(part);
+    item.Trim(" ");
+    if (item.Equals(onProto) || item.Equals(onInterface)) {
+      return true;
+    }
+  }
+  return false;
+}
