diff --git a/modules/libpref/init/StaticPrefList.yaml b/modules/libpref/init/StaticPrefList.yaml
--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -9283,6 +9283,14 @@
   value: false
   mirror: always
 
+# true = a new window never takes the foreground from another program: it
+# opens just behind it, without flashing the taskbar. Pages don't see this; a
+# driven page keeps focus through focusmanager.testmode.
+- name: ifox.window.noActivate
+  type: RelaxedAtomicBool
+  value: false
+  mirror: always
+
 # Firefox 160 probes video decoders with AssertCanInstantiate. false = 159's
 # probe, without it.
 - name: ifox.compat.media.assertCanInstantiate
diff --git a/widget/windows/nsWindow.cpp b/widget/windows/nsWindow.cpp
