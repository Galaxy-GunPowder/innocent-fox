diff --git a/toolkit/components/ifox/IfoxPipe.cpp b/toolkit/components/ifox/IfoxPipe.cpp
new file mode 100644
--- /dev/null
+++ b/toolkit/components/ifox/IfoxPipe.cpp
@@ -0,0 +1,126 @@
+/* Innocent Fox: line-based JSON channel to the launcher over two named pipes.
+ *
+ * The launcher creates both pipes (one instance each, local only) and passes
+ * their shared name with -ifox-pipe. Nothing listens on the network.
+ * Reads block on a detached thread that dies with the process, so a quiet
+ * pipe never holds up shutdown. Writes are synchronous on the main thread.
+ */
+
+#include "IfoxPipe.h"
+
+#include <windows.h>
+
+#include <string>
+
+#include "mozilla/UniquePtr.h"
+#include "nsProxyRelease.h"
+#include "nsString.h"
+#include "nsThreadUtils.h"
+#include "prthread.h"
+
+using namespace mozilla;
+
+NS_IMPL_ISUPPORTS(IfoxPipe, nsIIfoxPipe)
+
+namespace {
+
+struct ReaderArgs {
+  HANDLE mIn;
+  nsMainThreadPtrHandle<nsIIfoxPipeListener> mListener;
+};
+
+HANDLE OpenPipe(const nsAString& aName, const char16_t* aSuffix,
+                DWORD aAccess) {
+  nsAutoString path(u"\\\\.\\pipe\\"_ns);
+  path.Append(aName);
+  path.Append(aSuffix);
+  return ::CreateFileW(static_cast<const wchar_t*>(path.get()), aAccess,
+                       0, nullptr, OPEN_EXISTING, 0, nullptr);
+}
+
+void ReadLoop(void* aArg) {
+  UniquePtr<ReaderArgs> args(static_cast<ReaderArgs*>(aArg));
+  std::string pending;
+  static char buf[65536];
+  for (;;) {
+    DWORD got = 0;
+    if (!::ReadFile(args->mIn, buf, sizeof(buf), &got, nullptr) || got == 0) {
+      break;
+    }
+    pending.append(buf, got);
+    size_t start = 0;
+    size_t nl;
+    while ((nl = pending.find('\n', start)) != std::string::npos) {
+      nsCString line(pending.data() + start, nl - start);
+      start = nl + 1;
+      nsMainThreadPtrHandle<nsIIfoxPipeListener> listener = args->mListener;
+      NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "IfoxPipe::OnLine",
+          [listener, line]() { (void)listener->OnLine(line); }));
+    }
+    pending.erase(0, start);
+  }
+  ::CloseHandle(args->mIn);
+  nsMainThreadPtrHandle<nsIIfoxPipeListener> listener = args->mListener;
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "IfoxPipe::OnClose", [listener]() { (void)listener->OnClose(); }));
+}
+
+}  // namespace
+
+IfoxPipe::~IfoxPipe() {
+  if (mOut) {
+    ::CloseHandle(static_cast<HANDLE>(mOut));
+  }
+}
+
+NS_IMETHODIMP
+IfoxPipe::Open(const nsAString& aName, nsIIfoxPipeListener* aListener) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mOut || !aListener || aName.IsEmpty()) {
+    return NS_ERROR_UNEXPECTED;
+  }
+  HANDLE in = OpenPipe(aName, u"-in", GENERIC_READ);
+  if (in == INVALID_HANDLE_VALUE) {
+    return NS_ERROR_FILE_NOT_FOUND;
+  }
+  HANDLE out = OpenPipe(aName, u"-out", GENERIC_WRITE);
+  if (out == INVALID_HANDLE_VALUE) {
+    ::CloseHandle(in);
+    return NS_ERROR_FILE_NOT_FOUND;
+  }
+  mOut = out;
+
+  auto* args = new ReaderArgs{
+      in, nsMainThreadPtrHandle<nsIIfoxPipeListener>(
+              new nsMainThreadPtrHolder<nsIIfoxPipeListener>(
+                  "IfoxPipe::mListener", aListener))};
+  if (!PR_CreateThread(PR_SYSTEM_THREAD, ReadLoop, args, PR_PRIORITY_NORMAL,
+                       PR_GLOBAL_THREAD, PR_UNJOINABLE_THREAD, 0)) {
+    ::CloseHandle(in);
+    delete args;
+    return NS_ERROR_FAILURE;
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+IfoxPipe::Send(const nsACString& aLine) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mOut) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  nsAutoCString data(aLine);
+  data.Append('\n');
+  const char* p = data.get();
+  DWORD left = data.Length();
+  while (left) {
+    DWORD wrote = 0;
+    if (!::WriteFile(static_cast<HANDLE>(mOut), p, left, &wrote, nullptr)) {
+      return NS_ERROR_FAILURE;
+    }
+    p += wrote;
+    left -= wrote;
+  }
+  return NS_OK;
+}
