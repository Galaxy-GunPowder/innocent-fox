@@ -0,0 +1,28 @@
+# Innocent Fox: the launcher pipe and the agent behind it.
+# Started only by the -ifox-pipe flag; without it nothing here runs.
+
+XPIDL_MODULE = "toolkit_ifox"
+
+XPIDL_SOURCES += [
+    "nsIIfoxPipe.idl",
+]
+
+XPCOM_MANIFESTS += [
+    "components.conf",
+]
+
+EXPORTS += [
+    "IfoxPipe.h",
+]
+
+SOURCES += [
+    "IfoxPipe.cpp",
+]
+
+EXTRA_JS_MODULES += [
+    "IfoxAgent.sys.mjs",
+    "IfoxChild.sys.mjs",
+    "IfoxParent.sys.mjs",
+]
+
+FINAL_LIBRARY = "xul"
diff --git a/toolkit/components/ifox/nsIIfoxPipe.idl b/toolkit/components/ifox/nsIIfoxPipe.idl
new file mode 100644
--- /dev/null
+++ b/toolkit/components/ifox/nsIIfoxPipe.idl
@@ -0,0 +1,21 @@
+/* Innocent Fox: line-based JSON channel to the launcher over two named pipes. */
+
+#include "nsISupports.idl"
+
+[scriptable, uuid(5b1f3c2e-8d7a-4f0e-9a61-2c4e7d9b0a11)]
+interface nsIIfoxPipeListener : nsISupports
+{
+  /* One line from the launcher, without its newline. Main thread. */
+  void onLine(in AUTF8String aLine);
+  /* The launcher closed its end. Main thread. */
+  void onClose();
+};
+
+[scriptable, uuid(9e2d4a70-31c6-4b8f-b5d2-7a0c1e6f3b42)]
+interface nsIIfoxPipe : nsISupports
+{
+  /* Connects to \\.\pipe\<aName>-in (read) and \\.\pipe\<aName>-out (write). */
+  void open(in AString aName, in nsIIfoxPipeListener aListener);
+  /* Writes aLine plus a newline. aLine must not contain a newline. */
+  void send(in AUTF8String aLine);
+};
