+
+#include "nsIIfoxPipe.h"
+
+class IfoxPipe final : public nsIIfoxPipe {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  NS_DECL_NSIIFOXPIPE
+
+  IfoxPipe() = default;
+
+ private:
